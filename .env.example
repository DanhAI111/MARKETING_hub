PORT=3000
HOST=localhost
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=0
AUTH_REQUIRED=0
# Set to 1 ONLY for local dev to allow weak/missing secrets. In production leave
# unset — the server fails to start unless real 32+ char secrets are provided.
ALLOW_DEV_SECRETS=1
# Production requires SESSION_SECRET and TOKEN_ENCRYPTION_KEY to be at least 32 characters.
SESSION_SECRET=change-this-to-another-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# For personal Gmail login, prefer listing exact employee Gmail addresses in ALLOWED_EMAILS.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
ALLOW_EMPLOYEE_EMAILS=0

# Node/Express task email notifications via SMTP. For Gmail SMTP, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
TASK_DAILY_SUMMARY_ENABLED=0
TASK_DAILY_SUMMARY_HOUR=8

# Anthropic allocation suggestions. Keep the key empty here; set it only in .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_posts,instagram_basic,instagram_content_publish
TOKEN_ENCRYPTION_KEY=change-this-to-a-long-random-string
