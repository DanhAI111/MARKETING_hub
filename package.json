{
  "name": "mkt-hub",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.js",
    "dev": "npm run build:assets && wrangler dev",
    "dev:node": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test",
    "deploy": "npm run build:assets && wrangler deploy",
    "deploy:check": "npm run build:assets && wrangler deploy --dry-run",
    "d1:create": "wrangler d1 create marketing-hub",
    "d1:migrate:local": "wrangler d1 migrations apply marketing-hub --local",
    "d1:migrate:remote": "wrangler d1 migrations apply marketing-hub --remote",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "wrangler": "^4.60.0"
  }
}
